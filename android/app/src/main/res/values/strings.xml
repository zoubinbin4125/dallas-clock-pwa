    <string name="app_name">达拉斯时间</string>
    <string name="widget_desc_compact">小尺寸，适合 Z Fold 封面屏。显示达拉斯时间、上班状态和倒计时。</string>
    <string name="widget_desc_wide">宽尺寸，适合内屏。显示达拉斯时间、倒计时和下一个美国联邦假日。</string>
    <string name="eyebrow">DALLAS · 达拉斯</string>
